              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100"
            />
            
             GitHub

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/vscode/vscode-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             VSCode

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="/icons/illustrator.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             Illustrator

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="/icons/photoshop.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             Photoshop

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/figma/figma-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             Figma

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/canva/canva-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             Canva

