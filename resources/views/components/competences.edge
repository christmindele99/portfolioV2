<section id="competences" data-filter-group class="py-16 md:scroll-mt-24">
  <div data-reveal class="relative mx-auto w-[92%] max-w-[1100px] ">
    <h2 class="font-title mb-8 text-left text-3xl md:text-4xl">Competences</h2>

    <div class="mb-6 flex flex-wrap justify-start gap-2.5">
      <button
        type="button"
        data-filter="all"
        data-active="true"
        class="cursor-pointer rounded-lg border border-black/10 bg-white/50 px-4 py-2.5 text-base font-medium backdrop-blur-md transition hover:bg-ink hover:text-paper dark:border-white/10 dark:bg-white/5 dark:hover:bg-paper dark:hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-paper dark:data-[active=true]:border-paper dark:data-[active=true]:bg-paper dark:data-[active=true]:text-ink"
      >
        Tous
      </button>
      <button
        type="button"
        data-filter="frontend"
        class="cursor-pointer rounded-lg border border-black/10 bg-white/50 px-4 py-2.5 text-base font-medium backdrop-blur-md transition hover:bg-ink hover:text-paper dark:border-white/10 dark:bg-white/5 dark:hover:bg-paper dark:hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-paper dark:data-[active=true]:border-paper dark:data-[active=true]:bg-paper dark:data-[active=true]:text-ink"
      >
        Front-end
      </button>
      <button
        type="button"
        data-filter="backend"
        class="cursor-pointer rounded-lg border border-black/10 bg-white/50 px-4 py-2.5 text-base font-medium backdrop-blur-md transition hover:bg-ink hover:text-paper dark:border-white/10 dark:bg-white/5 dark:hover:bg-paper dark:hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-paper dark:data-[active=true]:border-paper dark:data-[active=true]:bg-paper dark:data-[active=true]:text-ink"
      >
        Back-end
      </button>
      <button
        type="button"
        data-filter="database"
        class="cursor-pointer rounded-lg border border-black/10 bg-white/50 px-4 py-2.5 text-base font-medium backdrop-blur-md transition hover:bg-ink hover:text-paper dark:border-white/10 dark:bg-white/5 dark:hover:bg-paper dark:hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-paper dark:data-[active=true]:border-paper dark:data-[active=true]:bg-paper dark:data-[active=true]:text-ink"
      >
        Base de données
      </button>
      <button
        type="button"
        data-filter="tools"
        class="cursor-pointer rounded-lg border border-black/10 bg-white/50 px-4 py-2.5 text-base font-medium backdrop-blur-md transition hover:bg-ink hover:text-paper dark:border-white/10 dark:bg-white/5 dark:hover:bg-paper dark:hover:text-ink data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-paper dark:data-[active=true]:border-paper dark:data-[active=true]:bg-paper dark:data-[active=true]:text-ink"
      >
        Outils
      </button>
    </div>

    <div data-stagger>
      <div
        data-category="frontend"
        class="grid gap-4 border-b border-black/10 py-6 last:border-b-0 md:grid-cols-[11rem_1fr] dark:border-white/10"
      >
        <h3 class="text-lg font-semibold">Front-end</h3>
        <div class="flex flex-wrap gap-3">
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/html5/html5-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             HTML5

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/css3/css3-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             CSS3

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             TailwindCSS

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             JavaScript

          </span>
        </div>
      </div>
      <div
        data-category="backend"
        class="grid gap-4 border-b border-black/10 py-6 last:border-b-0 md:grid-cols-[11rem_1fr] dark:border-white/10"
      >
        <h3 class="text-lg font-semibold">Back-end</h3>
        <div class="flex flex-wrap gap-3">
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             NodeJS

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/adonisjs/adonisjs-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             AdonisJS

          </span>
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg"
              alt=""
              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             TypeScript

          </span>
        </div>
      </div>
      <div
        data-category="database"
        class="grid gap-4 border-b border-black/10 py-6 last:border-b-0 md:grid-cols-[11rem_1fr] dark:border-white/10"
      >
        <h3 class="text-lg font-semibold">Bases de données</h3>
        <div class="flex flex-wrap gap-3">
          <span
