              loading="lazy"
              class="size-6 shrink-0 md:grayscale md:opacity-80 transition md:dark:invert md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:invert-0"
            />
            
             PostgreSQL

          </span>
        </div>
      </div>
      <div
        data-category="tools"
        class="grid gap-4 border-b border-black/10 py-6 last:border-b-0 md:grid-cols-[11rem_1fr] dark:border-white/10"
      >
        <h3 class="text-lg font-semibold">Outils</h3>
        <div class="flex flex-wrap gap-3">
          <span
            class="group inline-flex items-center gap-2.5 px-4 py-2.5 text-base rounded-lg border border-black/10 bg-white/50 md:hover:border-ink md:dark:hover:border-paper dark:border-white/10 dark:bg-white/5 font-medium transition"
          >
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg"
