<section
  id="contact"
  {{
    flashMessages.has('success') || flashMessages.has('inputErrorsBag')
      ? 'data-feedback'
      : ''
  }}
  class="py-16 md:scroll-mt-24"
>
  <div data-reveal class="relative mx-auto w-[92%] max-w-[1100px]">
    @if(flashMessages.has('success'))
      <div class="mb-6 rounded-xl border border-accent bg-accent/10 p-4 text-sm font-medium">
        {{ flashMessages.get('success') }}
      </div>
    @end

    <div data-stagger class="flex flex-col gap-10 md:flex-row md:items-stretch md:gap-8">
      {{-- Colonne gauche : formulaire de contact --}}
      <div class="flex flex-col md:w-1/2">
        <h2 class="font-title mb-8 text-left text-3xl md:text-4xl">Me contacter</h2>

        <div
          class="flex flex-1 flex-col rounded-xl p-5 border border-black/10 bg-white/50 backdrop-blur-md dark:border-white/10 dark:bg-white/5"
        >
          <p class="mb-4 text-left text-sm opacity-80">
            Un projet, une collaboration ou une demande de service ? Écris-moi, je réponds rapidement.
          </p>

          <form method="POST" action="/messages" class="flex flex-1 flex-col">
            {{ csrfField() }}
            <div class="mb-3 flex flex-col gap-1.5 ">
              <label for="fullname" class="text-sm font-medium">Nom complet</label>
              <input
                id="fullname"
                name="fullname"
                type="text"
                maxlength="250"
                value="{{ old('fullname') || '' }}"
                placeholder="Ex. Jean Kabongo"
                required
                class="rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm outline-none focus:ring-2 focus:ring-accent dark:border-white/15 dark:bg-night"
              />
              @inputError('fullname')
                <p class="text-xs font-medium">Écris ton nom complet (2 caractères minimum).</p>
              @end
            </div>
            <div class="flex flex-col md:flex-row md:gap-3">
              <div class="mb-3 flex flex-col gap-1.5 md:flex-1">
                <label for="email" class="text-sm font-medium">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  maxlength="250"
                  value="{{ old('email') || '' }}"
                  placeholder="vous@exemple.com"
                  required
                  class="rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm outline-none focus:ring-2 focus:ring-accent dark:border-white/15 dark:bg-night"
                />
                @inputError('email')
                  <p class="text-xs font-medium">Écris une adresse email valide.</p>
                @end
              </div>
              <div class="mb-3 flex flex-col gap-1.5 md:flex-1">
                <label for="number" class="text-sm font-medium">Téléphone</label>
                <input
                  id="number"
                  name="number"
                  type="tel"
                  maxlength="150"
                  value="{{ old('number') || '' }}"
                  placeholder="+243 000 000 000"
                  required
                  class="rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm outline-none focus:ring-2 focus:ring-accent dark:border-white/15 dark:bg-night"
                />
                @inputError('number')
                  <p class="text-xs font-medium">Écris un numéro de téléphone valide.</p>
                @end
              </div>
            </div>
            <div class="mb-3 flex flex-col gap-1.5 flex-1">
              <label for="contain" class="text-sm font-medium">Message</label>
              <textarea
                id="contain"
                name="contain"
                rows="4"
                placeholder="Décris ton projet ou ta demande"
                required
                class="min-h-40 flex-1 resize-none rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm outline-none focus:ring-2 focus:ring-accent dark:border-white/15 dark:bg-night"
              >{{ old('contain') || '' }}</textarea>
              @inputError('contain')
                <p class="text-xs font-medium">Écris un message d'au moins 5 caractères.</p>
              @end
            </div>
            <button
              type="submit"
              class="mt-2 w-full cursor-pointer inline-flex items-center justify-center gap-2 rounded-full border px-5 py-3 font-semibold transition hover:-translate-y-0.5 bg-accent border-accent text-ink"
            >
              Envoyer le message
            </button>
          </form>
        </div>
      </div>
      {{-- Colonne droite : formulaire d'avis --}}
      <div class="flex flex-col md:w-1/2">
        <h2 class="font-title mb-8 text-left text-3xl md:text-4xl">Ce qu'on dit de moi</h2>

        <div
          class="flex flex-1 flex-col rounded-xl p-5 border border-black/10 bg-white/50 backdrop-blur-md dark:border-white/10 dark:bg-white/5"
        >
          <p class="mb-4 text-left text-sm opacity-80">
            Tu as travaillé avec moi ? Laisse ton avis, il sera publié sur le site.
          </p>

          <form method="POST" action="/comments" class="flex flex-1 flex-col">
            {{ csrfField() }}
            <div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-start">
              <div class="flex flex-1 flex-col gap-1.5">
                <label for="review-author" class="text-sm font-medium">Nom complet</label>
                <input
                  id="review-author"
                  name="author"
                  type="text"
                  maxlength="250"
                  value="{{ old('author') || '' }}"
                  placeholder="Ex. Grace Kabeya"
                  required
                  class="rounded-lg border border-black/15 bg-white px-3.5 py-2.5 text-sm outline-none focus:ring-2 focus:ring-accent dark:border-white/15 dark:bg-night"
                />
                @inputError('author')
                  <p class="text-xs font-medium">Écris ton nom complet (2 caractères minimum).</p>
                @end
              </div>
              <div data-rating class="flex flex-col gap-1.5">
                <span class="text-sm font-medium">Note</span>
                <div data-stars-row class="flex gap-0.5 py-1">
                  <button
                    type="button"
                    data-star="1"
                    aria-label="1 sur 6"
                    class="group/star cursor-pointer p-0.5"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="size-5 fill-none stroke-accent transition group-data-[on=true]/star:fill-accent"
                    >
                      <polygon
                        points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                      />
                    </svg>
                  </button>
                  <button
                    type="button"
                    data-star="2"
