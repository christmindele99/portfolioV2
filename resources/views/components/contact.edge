    </div>
    {{-- Avis publiés : viennent de la base de données (HomeController) --}}
    <div data-stagger class="grid grid-cols-1 gap-4 lg:grid-cols-3 mt-8">
      @if(reviews.length)
        @each(review in reviews)
          <article
            class="min-w-0 rounded-xl p-4 md:flex-1 border border-black/10 bg-white/50 backdrop-blur-md dark:border-white/10 dark:bg-white/5"
          >
            <div class="flex items-center gap-3">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full bg-accent/20 text-xs font-semibold"
              >
                {{ review.initials }}
              </span>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold leading-tight">{{ review.fullname }}</p>
                <p class="truncate text-xs opacity-70">{{ review.email }}</p>
              </div>
              <div class="flex shrink-0 gap-0.5" aria-label="Note : {{ review.rating }} sur 6">
                @each(n in [1, 2, 3, 4, 5, 6])
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="size-3.5 shrink-0 stroke-accent {{ n <= review.rating ? 'fill-accent' : 'fill-none' }}"
                  >
                    <polygon
                      points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
                    />
                  </svg>
                @end
              </div>
            </div>
            <p data-review-text class="mt-3 line-clamp-4 text-sm wrap-break-word opacity-90">{{ review.contain }}</p>
            <button type="button" data-review-toggle hidden class="mt-2 cursor-pointer text-sm font-semibold text-accent hover:underline">
              Voir plus
            </button>
          </article>
        @end
      @else
        <p class="text-sm opacity-70">
          Aucun avis pour le moment. Sois le premier à en laisser un !
        </p>
      @end
    </div>
  </div>
</section>
