                      />
                    </svg>
                  </button>
                </div>
                <input type="hidden" name="rating" value="{{ old('rating') || 0 }}" />
                @inputError('rating')
                  <p class="text-xs font-medium">Choisis une note de 1 à 6.</p>
                @end
                <p data-rating-error class="hidden text-xs font-medium">Choisis une note de 1 à 6 avant de publier.</p>
              </div>
            </div>
            <div class="mb-3 flex flex-col gap-1.5 ">
              <label for="review-email" class="text-sm font-medium">Email</label>
              <input
